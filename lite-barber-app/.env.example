# URL pública da API usada pelo frontend.
# Em desenvolvimento, deixe vazia para usar o proxy de Vite.
VITE_API_BASE_URL=

# Endereço usado pelo proxy do Vite para encaminhar /api e /storage.
VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# Slug usado como fallback ao acessar URLs públicas sem slug.
VITE_DEFAULT_SHOP_SLUG=elite-agenda
